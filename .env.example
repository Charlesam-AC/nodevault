# Copy to .env and replace every value before pointing NodeVault at a real bank.
# .env is gitignored. Do not commit live passwords, PINs, or Entra secrets.

# PostgreSQL superuser (administration and schema init only; the API does not use this account)
POSTGRES_USER=nodevault
POSTGRES_PASSWORD=change-me-postgres-admin
POSTGRES_DB=nodevault

# Least-privilege role the API connects as. No update/delete/truncate on the ledger.
APP_DB_PASSWORD=change-me-nodevault-app

# API session signing key. Use at least 32 random characters.
JWT_SECRET=change-me-jwt-secret-at-least-32-chars

# White-label lock. Sign-in emails must end with this domain.
# Leave empty to allow every tenant domain stored in bank_tenants.
ENFORCED_CORPORATE_DOMAIN=demo-bank.example

# Microsoft Entra ID. "mock" accepts MOCK_ENTRA_ASSERTION for local use.
# "entra" refuses to start a session unless a live token verifier is configured;
# this build fails closed rather than trusting unsigned tokens.
ENTRA_MODE=mock
MOCK_ENTRA_ASSERTION=change-me-entra-assertion
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=

# Password sign-in sits beside Entra.
# Local passwords are accepted only when ENABLE_LOCAL_LOGIN=true and AUTH_MODE is not entra.
# A live Entra deployment turns password sign-in off:
#   AUTH_MODE=entra
#   ENABLE_LOCAL_LOGIN=false
AUTH_MODE=both
ENABLE_LOCAL_LOGIN=true
# Demo directory password. Not a closing PIN, and not a production secret.
DEMO_PASSWORD=Vault-demo-2026
# Master admin can sign in while the seeded IT super admin stays frozen.
# Created on startup when SEED_DEMO_DATA=true. Not the closing PIN.
MASTER_ADMIN_EMAIL=admin@demo-bank.example
MASTER_ADMIN_PASSWORD=NodeVault-admin-2026
# Lock the account after this many wrong passwords. The lock lasts the given minutes.
LOCAL_LOGIN_MAX_FAILURES=5
LOCAL_LOGIN_LOCKOUT_MINUTES=15

# Normal desk sessions. Break-glass maintenance windows are always 60 minutes.
SESSION_TTL_MINUTES=480

# Business morning for balance carry-forward. Africa/Lusaka has no daylight-saving shift.
# The job rolls a locked Bal c/d into the next trading morning's Bal b/f at this local time.
# TRADING_WEEKDAYS defaults to Monday–Saturday. Sunday is closed unless it is listed.
# The built-in Zambian public-holiday calendar is always applied. BANK_HOLIDAYS adds
# extra YYYY-MM-DD dates on top of that calendar. Branch closures are set in the desk.
BUSINESS_TIMEZONE=Africa/Lusaka
BUSINESS_DAY_START=08:00
TRADING_WEEKDAYS=Mon,Tue,Wed,Thu,Fri,Sat
BANK_HOLIDAYS=

# Dev seed (sample books, custodians, weekly coordinator). PIN is dev-only.
SEED_DEMO_DATA=true
DEMO_CLOSING_PIN=135790
PIN_BCRYPT_ROUNDS=10

# Core banking position check. mock reads mock_core_positions.
# http GETs ${CORE_BANK_API_URL}/v1/position/:branchId and requires decimal strings.
CORE_BANK_MODE=mock
CORE_BANK_API_URL=http://corebank.internal/api
ENABLE_CORE_BANK_STUB=true

# Silent network printer. stub logs the job. network POSTs the raw sheet to PRINTER_URL.
PRINTER_MODE=stub
PRINTER_TARGET=Vault_Master_Printer_01
PRINTER_URL=

# Closing-sheet mail. stub logs recipients. smtp uses the host below.
MAIL_MODE=stub
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nodevault@demo-bank.example
ROM_EMAIL=rom@demo-bank.example

# Host port published for the API (container still listens on 8080).
API_PORT=8080
# Host port published so `npm test` can reach Postgres from the machine running Compose.
DB_PUBLISH_PORT=54329
